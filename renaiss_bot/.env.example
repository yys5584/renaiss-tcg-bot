RENAISS_BOT_TOKEN=
# Non-secret numeric id returned by getMe for this dedicated Renaiss bot.
RENAISS_EXPECTED_BOT_ID=
# Required for the public c -> guess -> reveal loop and public Result Bell.
# Use the Telegram supergroup id (normally starts with -100).
RENAISS_OFFICIAL_CHAT_ID=
RENAISS_OFFICIAL_GROUP_URL=
DATABASE_URL=
# Required before any schema mutation. Generate from the intended DATABASE_URL
# with: python -m renaiss_bot.tools.prepare_database --print-target-fingerprint
RENAISS_EXPECTED_DATABASE_FINGERPRINT=
# Required endpoint to the same PostgreSQL cluster and database as DATABASE_URL.
# It must preserve one backend session for the Telegram advisory lock: use a
# direct PostgreSQL or session-mode endpoint, never PgBouncer transaction pooling.
RENAISS_TELEGRAM_LOCK_DATABASE_URL=
RENAISS_DB_POOL_MAX=4
RENAISS_DB_ACQUIRE_TIMEOUT_SECONDS=5
RENAISS_DB_SSL_INSECURE=0
# Optional project CA for verified managed PostgreSQL connections.
RENAISS_DB_SSL_CA_FILE=

# Optional Discord adapter. Use a separate Discord bot token.
RENAISS_DISCORD_TOKEN=
# Non-secret application/bot user id for the dedicated Discord bot.
RENAISS_EXPECTED_DISCORD_BOT_ID=
RENAISS_DISCORD_GUILD_ID=
# High-impact fallback. Keep 0 for the guild-scoped pilot.
RENAISS_DISCORD_ALLOW_GLOBAL_SYNC=0

RENAISS_SKIP_DB=0
LOG_LEVEL=INFO

# Optional loopback-only Telegram process health listener.
RENAISS_TELEGRAM_HEALTH_ENABLED=0
RENAISS_TELEGRAM_HEALTH_PORT=18081

RENAISS_BASE_URL=https://www.renaiss.xyz
RENAISS_REFERRAL_URL=
RENAISS_REFERRAL_CODE=
RENAISS_REFERRAL_PARAM=ref

# Optional standalone HTTPS redirect service for real outbound-click measurement.
RENAISS_CLICK_TRACKER_PUBLIC_BASE_URL=
RENAISS_CLICK_TRACKER_SECRET=
RENAISS_TRACKING_CREATE_TIMEOUT_SECONDS=0.5
RENAISS_EVENT_TIMEOUT_SECONDS=1.0
RENAISS_STARTER_GRANT_TIMEOUT_SECONDS=1.0
RENAISS_CLICK_ALLOWED_HOSTS=renaiss.xyz,www.renaiss.xyz,index.renaissos.com
RENAISS_CLICK_TOKEN_TTL_DAYS=30
RENAISS_CLICK_TRACKER_HOST=127.0.0.1
RENAISS_CLICK_TRACKER_PORT=8090
RENAISS_CLICK_DB_TIMEOUT_SECONDS=2

RENAISS_API_BASE_URL=https://api.renaissos.com
RENAISS_API_ALLOWED_HOSTS=api.renaissos.com
RENAISS_API_SEARCH_PATH=/v1/search
RENAISS_API_SEARCH_LIMIT=12
RENAISS_API_KEY=
RENAISS_API_SECRET=
RENAISS_API_KEY_HEADER=X-Api-Key
RENAISS_API_SECRET_HEADER=X-Api-Secret
# Keep empty until Renaiss confirms the documented route is live in the API/OpenAPI.
RENAISS_API_ITEM_BY_NO_PATH=
RENAISS_API_EXACT_CONTRACT=
# Keep empty until an approved response fixture explicitly identifies the
# competitive price field as a median. Configuration is not source evidence.
RENAISS_API_EXACT_VALUATION_METHOD=
# Comma-separated Ed25519 public-key DER SHA-256 fingerprints for key rotation.
RENAISS_MANIFEST_PUBLIC_KEY_SHA256=
RENAISS_MANIFEST_SHA256=
RENAISS_PRICE_SOURCE_ALLOWED_HOSTS=renaiss.xyz,www.renaiss.xyz,index.renaissos.com
RENAISS_PRICE_CACHE_TIMEOUT_SECONDS=0.5
RENAISS_PRICE_REQUEST_TIMEOUT_SECONDS=4.5
RENAISS_PRICE_CACHE_TTL_MINUTES=10
RENAISS_PRICE_USER_COOLDOWN_SECONDS=10
RENAISS_API_MAX_CONCURRENCY=2
RENAISS_API_MIN_INTERVAL_MS=500
RENAISS_API_QUEUE_WAIT_SECONDS=2
RENAISS_IMAGE_ALLOWED_HOSTS=images.pokemontcg.io
RENAISS_IMAGE_MAX_BYTES=5000000
RENAISS_RENDER_POOL_SIZE=2
RENAISS_RENDER_TOTAL_TIMEOUT_SECONDS=8
RENAISS_RENDER_IMAGE_CACHE_SIZE=8
RENAISS_RENDER_FINAL_CACHE_SIZE=16
RENAISS_MEDIA_CACHE_TIMEOUT_SECONDS=0.35

# High-volume private packs stay closed during the public-loop pilot.
RENAISS_PRIVATE_FREE_PACKS_ENABLED=0

# User-invoked /flex is also bounded at the collaboration-room level.
RENAISS_FLEX_ROOM_DAILY_LIMIT=3
RENAISS_FLEX_ROOM_COOLDOWN_SECONDS=300
RENAISS_FLEX_RESERVATION_TTL_SECONDS=300

# Daily Pick stays hidden unless enabled AND PostgreSQL/key/secret/structural path are set.
RENAISS_DAILY_PICK_ENABLED=0
RENAISS_DAILY_PICK_REFRESH_SECONDS=3600
RENAISS_DAILY_PICK_REFRESH_LIMIT=8
RENAISS_DAILY_PICK_REFRESH_LEASE_SECONDS=180
RENAISS_DAILY_PICK_MIN_CONFIDENCE_SCORE=0.7
RENAISS_DAILY_PICK_MIN_SOURCE_COUNT=2
# Required known-good structural tuple when RENAISS_DAILY_PICK_ENABLED=1.
RENAISS_DAILY_PICK_PROBE_CATEGORY=pokemon_tcg
RENAISS_DAILY_PICK_PROBE_CARD_NAME=
RENAISS_DAILY_PICK_PROBE_SET_NAME=
RENAISS_DAILY_PICK_PROBE_SET_CODE=
RENAISS_DAILY_PICK_PROBE_ITEM_NO=
RENAISS_DAILY_PICK_PROBE_VARIATION=
RENAISS_DAILY_PICK_PROBE_LANGUAGE=English
RENAISS_DAILY_PICK_PROBE_GRADE=RAW

# Normal group cadence. Each delay is randomized in this range (minimum 60s).
RENAISS_FIRST_SPAWN_DELAY_SECONDS=60
RENAISS_SPAWN_INTERVAL_MIN_SECONDS=7200
RENAISS_SPAWN_INTERVAL_MAX_SECONDS=14400
RENAISS_SPAWN_DAILY_CAP=6
RENAISS_SPAWN_QUIET_START_HOUR_KST=0
RENAISS_SPAWN_QUIET_END_HOUR_KST=9

# Round-level catch-only vs insight experiment. Off by default. When enabled,
# a private salt of at least 16 characters is required or normal gameplay remains unchanged.
RENAISS_COHORT_EXPERIMENT_ENABLED=0
RENAISS_COHORT_EXPERIMENT_SALT=

# Legacy RP/premium pack economy. Keep off for the collector-market pilot.
# Legacy RP/premium-pack economy is retired and cannot be enabled.

# Optional legacy daily price quiz. Its chat id never substitutes for the
# collector pilot's required RENAISS_OFFICIAL_CHAT_ID.
RENAISS_QUIZ_CHAT_ID=
RENAISS_QUIZ_OPEN_SECONDS=120

# Catalog import from POKARD (card universe). VM-only (IP allowlist).
POKARD_API_BASE_URL=
POKARD_API_KEY=
