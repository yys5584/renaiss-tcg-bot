# Copy this file to an access-controlled path outside the repository, normally
# %ProgramData%\Renaiss\secrets\web.env. Never reuse the Telegram bot .env.

# Use a dedicated PostgreSQL LOGIN role with SELECT only on the three listed
# Renaiss tables. Do not use the bot owner/migration credential.
DATABASE_URL=postgresql://renaiss_web_reader:replace-me@db.example.com:5432/renaiss
# Generate this non-secret digest from the exact DATABASE_URL target with:
# python -m renaiss_bot.tools.prepare_database --print-target-fingerprint
RENAISS_EXPECTED_DATABASE_FINGERPRINT=
RENAISS_DB_POOL_MAX=4
RENAISS_DB_ACQUIRE_TIMEOUT_SECONDS=5
RENAISS_DB_SSL_INSECURE=0
# Optional absolute path to the managed PostgreSQL project CA.
RENAISS_DB_SSL_CA_FILE=

RENAISS_WEB_HOST=127.0.0.1
RENAISS_WEB_PORT=18082
# Generate an independent random value of at least 32 characters.
RENAISS_WEB_SESSION_SECRET=
RENAISS_OFFICIAL_GROUP_URL=https://t.me/replace-with-game-room
RENAISS_TELEGRAM_OIDC_CLIENT_ID=
RENAISS_TELEGRAM_OIDC_CLIENT_SECRET=
RENAISS_TELEGRAM_OIDC_REDIRECT_URI=https://tgpoke.com/renaiss/api/auth/telegram/callback
RENAISS_IMAGE_ALLOWED_HOSTS=images.pokemontcg.io
RENAISS_WEB_PREVIEW=0
LOG_LEVEL=INFO
